{
  "name": "ftpilot",
  "displayName": "FTPilot",
  "description": "Build and FTP-deploy a git 'deploy' branch to multiple cPanel domains/subdomains, one click.",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ftpilot.setup",
        "title": "FTPilot: Configure Project",
        "icon": "$(gear)"
      },
      {
        "command": "ftpilot.deploy",
        "title": "FTPilot: Deploy / Redeploy",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "ftpilot.fullRedeploy",
        "title": "FTPilot: Force Full Re-upload",
        "icon": "$(sync)"
      },
      {
        "command": "ftpilot.setCredentials",
        "title": "FTPilot: Set FTP Credentials",
        "icon": "$(key)"
      },
      {
        "command": "ftpilot.editConfig",
        "title": "FTPilot: Edit Config File",
        "icon": "$(json)"
      },
      {
        "command": "ftpilot.refreshTree",
        "title": "FTPilot: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ftpilot",
          "title": "FTPilot",
          "icon": "media/activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "ftpilot": [
        {
          "id": "ftpilotTargets",
          "name": "Deploy Targets"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ftpilotTargets",
        "contents": "No FTPilot config found in this project.\n[Configure Project](command:ftpilot.setup)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ftpilot.deploy",
          "when": "view == ftpilotTargets",
          "group": "navigation@1"
        },
        {
          "command": "ftpilot.fullRedeploy",
          "when": "view == ftpilotTargets",
          "group": "navigation@2"
        },
        {
          "command": "ftpilot.setCredentials",
          "when": "view == ftpilotTargets",
          "group": "navigation@3"
        },
        {
          "command": "ftpilot.editConfig",
          "when": "view == ftpilotTargets",
          "group": "navigation@4"
        },
        {
          "command": "ftpilot.setup",
          "when": "view == ftpilotTargets",
          "group": "navigation@5"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "basic-ftp": "^5.0.4"
  }
}
