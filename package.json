{
  "name": "ftpilot",
  "displayName": "FTPilot",
  "description": "Build and FTP-deploy a git 'deploy' branch to multiple cPanel domains/subdomains, one click.",
  "version": "0.1.0",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/IshanKulkarni02/ftpilot.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "ftpilot.deploy",
        "title": "FTPilot: Deploy / Redeploy",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "ftpilot.backup",
        "title": "FTPilot: Backup Server Now",
        "icon": "$(archive)"
      },
      {
        "command": "ftpilot.fullRedeploy",
        "title": "FTPilot: Force Full Re-upload",
        "icon": "$(sync)"
      },
      {
        "command": "ftpilot.setCredentials",
        "title": "FTPilot: Set FTP Credentials",
        "icon": "$(key)"
      },
      {
        "command": "ftpilot.editConfig",
        "title": "FTPilot: Edit Config File",
        "icon": "$(json)"
      },
      {
        "command": "ftpilot.openInEditor",
        "title": "FTPilot: Open Configuration",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ftpilot.openHelp",
        "title": "FTPilot: Quick Reference",
        "icon": "$(question)"
      },
      {
        "command": "ftpilot.preview",
        "title": "FTPilot: Preview Deploy (Dry Run)",
        "icon": "$(eye)"
      },
      {
        "command": "ftpilot.rollback",
        "title": "FTPilot: Roll Back a Deploy\u2026",
        "icon": "$(discard)"
      },
      {
        "command": "ftpilot.cancelDeploy",
        "title": "FTPilot: Cancel Running Deploy",
        "icon": "$(debug-stop)"
      },
      {
        "command": "ftpilot.toggleGeekMode",
        "title": "FTPilot: Toggle Geek Mode"
      },
      {
        "command": "ftpilot.openDashboard",
        "title": "FTPilot: Open Geek Mode Dashboard",
        "icon": "$(dashboard)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ftpilot",
          "title": "FTPilot",
          "icon": "media/activitybar-icon-128.png"
        }
      ]
    },
    "views": {
      "ftpilot": [
        {
          "id": "ftpilotPanel",
          "name": "FTPilot",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "ftpilot.openDashboard",
          "when": "view == ftpilotPanel && config.ftpilot.geekMode",
          "group": "navigation@0"
        },
        {
          "command": "ftpilot.openInEditor",
          "when": "view == ftpilotPanel",
          "group": "navigation@1"
        },
        {
          "command": "ftpilot.openHelp",
          "when": "view == ftpilotPanel",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "ftpilot.openDashboard",
          "when": "config.ftpilot.geekMode"
        },
        {
          "command": "ftpilot.deployTarget",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "FTPilot",
      "properties": {
        "ftpilot.geekMode": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "**Geek Mode**: open a live dashboard (gauges, throughput and connection charts, per-file timings, event log) whenever a deploy starts. Off by default; when off, all dashboard entry points are hidden."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node scripts/check-webview.js",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "archiver": "^8.0.0",
    "basic-ftp": "^5.0.4"
  }
}
